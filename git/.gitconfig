[user]
    email = r-arya@ti.com
    name = "Raaghav Arya"
[core]       
    gitproxy = none for ti.com
    gitproxy = /home/a0507112/git-proxy.sh
    editor = ~/.git-editor.sh
    autocrlf = false
    pager = delta
[http]
    proxy = http://webproxy.ext.ti.com:80
[https]
    proxy = http://webproxy.ext.ti.com:80
[init]
	defaultBranch = main
[color]
	ui = auto
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = store
[delta]
    dark = true
    side-by-side = true

[alias]
	child = "!f() { h=$(git rev-parse \"$1\") || return 1; n=${2:-1}; list=\"\"; cur=\"$h\"; i=0; while [ \"$i\" -lt \"$n\" ]; do child=$(git rev-list --all --children | grep \"^$cur \" | cut -d\" \" -f2 | head -n1); [ -z \"$child\" ] && break; list=\"$list $child\"; cur=\"$child\"; i=$((i+1)); done; [ -z \"$list\" ] && return 0; git log --oneline --no-walk $list; }; f"
