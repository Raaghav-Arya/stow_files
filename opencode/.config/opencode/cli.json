{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "/home/raaghav/projects/opencode/plugins/opencode-vim-navigation",
    "./plugins/backslash-newline",
    "./plugins/plan-review"
  ],
  "keybinds": {
    "prompt.stash": {
      "key": "ctrl+s",
      "preventDefault": true
    },
    "prompt.stash.pop": "ctrl+alt+s",
    "prompt.stash.list": "<leader>p",
    "dialog.select.submit": "return,ctrl+y",
    "prompt.autocomplete.complete": "tab,ctrl+y",
    "form.option.prev": "up,k,ctrl+p",
    "form.option.next": "down,j,ctrl+n",
    "form.option.select": "return,ctrl+y"
  },
  "theme": {
    "name": "opencode"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "tps": true,
    "verbosity": "high"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  }
}
