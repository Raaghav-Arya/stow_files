{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "opencode-vim-navigation@0.1.5",
    "./plugins/backslash-newline",
    "./plugins/form-ctrl-nav",
    "-opencode.prompt.footer"
  ],
  "keybinds": {
    "app.exit": "<leader>q",
    "prompt.stash": {
      "key": "ctrl+s",
      "preventDefault": true
    },
    "prompt.stash.pop": "ctrl+alt+s",
    "prompt.stash.list": "<leader>p"
  },
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "status"
  },
  "prompt": {
    "paste": "compact"
  }
}
